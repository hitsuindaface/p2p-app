# Keep line endings right for each platform, whichever system the file is committed from.
# A Makefile or shell script with Windows line endings fails on Linux, and the reverse
# can happen to .cmd files on Windows.
*            text=auto
Makefile     text eol=lf
*.sh         text eol=lf
.dependencies text eol=lf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
